<UserControl x:Class="AnemiaPrediction.PluginUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:commonUtil="clr-namespace:PluginBase.CommonUtils;assembly=PluginBase"
             mc:Ignorable="d" 
             d:DesignHeight="670" d:DesignWidth="1260">
    <Border Background="#ffbcbc" CornerRadius="0,0,0,0" Opacity="1" BorderBrush="#757575" BorderThickness="1">
        <Grid AllowDrop="True">
            <commonUtil:RoundButton  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,10,0"
                       FontSize="15" Foreground="#000000">
                <TextBlock Text="X"/>
            </commonUtil:RoundButton>
            <Button Content="Connect No.1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0,0,0"
                       FontSize="15" Foreground="#000000" Command="{Binding ConnectCommand}"/>
            <TextBlock Text="Hello From AnemiaPrediction" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" FontSize="40" Foreground="#000000"/>
        </Grid>
    </Border>
</UserControl>
