<UserControl x:Class="Platform.CustomControls.NavigationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Platform.CustomControls"
             xmlns:util="clr-namespace:Platform.Utils"
             xmlns:commonUtil="clr-namespace:PluginBase.CommonUtils;assembly=PluginBase"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="215"
             Width="215">
    <Border Background="White" CornerRadius="0,0,0,10" BorderBrush="Black" BorderThickness="0,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Components" Margin="10,0" VerticalAlignment="Top"
                   Foreground="#FFB3B3B3" BorderThickness="1"/>
            <StackPanel Grid.Row="1" x:Name="ComponentStack" Margin="10,0" HorizontalAlignment="Stretch"
                        AllowDrop="True" Drop="SwapComponents">
                <ItemsControl ItemsSource="{Binding plugins}" ItemTemplate="{StaticResource ComponentTemplate}"/>
            </StackPanel>
            <Grid Grid.Row="2">
                <commonUtil:RoundButton Content="+" Margin="10,5" Click="CreateNewComponet"
                    BorderBrush="LightGray" BorderThickness="0" CornerRadius="5" Foreground="Gray"
                    VerticalContentAlignment="Center" Style="{StaticResource DefaultButton}"/>
                <Rectangle Stroke="#FFDADADA" StrokeThickness="2" StrokeDashArray="4 2" Margin="10,5" RadiusX="5" RadiusY="5"/>
            </Grid>
            <Border Grid.Row="3" Margin="10,5" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="Gray"
                             SelectionBrush="#FFBDBDBD" VerticalContentAlignment="Center"
                             BorderThickness="0" FocusVisualStyle="{x:Null}" FontStretch="Normal"
                             Text="🔍"/>
                    <TextBox Grid.Column="1" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="Gray"
                             SelectionBrush="#FFBDBDBD" VerticalContentAlignment="Center"
                             BorderThickness="0" FocusVisualStyle="{x:Null}" FontStretch="Normal"
                             Text="Search ..." 
                             />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
