<UserControl x:Class="Platform.CustomControls.MainPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Platform.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="690" d:DesignWidth="1280">
    <Border Background="#FFF2F3F4" CornerRadius="0,0,10,0" Opacity="1">
        <Grid AllowDrop="True" Margin="10" Drop="DoDrop">
            <TextBlock Text="+" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" FontSize="40" Foreground="#FFCCCCCC"/>
            <Rectangle Stroke="#FFDADADA" StrokeThickness="2" StrokeDashArray="8 4"
                       Fill="Transparent"/>
            <ContentControl Content="{Binding pluginUI}" Margin="10"/>
        </Grid>
        
    </Border>
</UserControl>
